NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay test keys for sandbox. Never put live secrets in the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional fallback if private_settings.consultation_phone is empty.
# Delivered only after a verified phone-consultation payment or approved bypass.
CONSULTATION_PHONE=

# Temporary customer payment bypass. Server-side only.
# When true, forms show "Continue Without Payment — Temporary".
PAYMENT_BYPASS_MODE=false

# Development-only admin access. Must stay false in production.
# Starting with NODE_ENV=production and ADMIN_DEV_BYPASS=true will fail.
ADMIN_DEV_BYPASS=false
